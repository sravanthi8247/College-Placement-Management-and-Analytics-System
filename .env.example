# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

# Client origin used by CORS
CLIENT_URL=http://localhost:5173

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Required to register a new user as Admin. Keep this secret.
# Anyone without this code is always registered as a student.
ADMIN_INVITE_CODE=replace-with-your-admin-invite-code

# Supabase Storage (Private Resume Bucket)
# Required in production to persist uploaded resumes across container restarts.
# Never expose the service role key to frontend code or commit to source control.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key
SUPABASE_BUCKET_NAME=student-resumes
